# Server Configuration
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3001,http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskify_dev
DB_NAME_TEST=taskify_test
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# Email Configuration (when you add email service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Redis Configuration (when you add caching)
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6397
REDIS_PASSWORD
REDIS_DB=0

# API Keys (when you add external services)
# STRIPE_SECRET_KEY=sk_test_...
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key


# RabbitMQ Configurations
RABBITMQ_PROTOCOL='amqp'
RABBITMQ_HOSTNAME='localhost'
RABBITMQ_PORT=5672
RABBITMQ_USERNAME='guest'
RABBITMQ_PASSWORD='guest'
RABBITMQ_VHOST='/'
RABBITMQ_RECONNECT_INTERVAL=5000
RABBITMQ_RECONNECT_ATTEMPTS=10
RABBITMQ_EXCHANGE_NAME='notif_exchange'
RABBITMQ_QUEUE_NAME='notif_queue'